# Replace PUBLIC_IP and the password hash before use.
# Certbot renews the short-lived public IP certificate and its deploy hook copies it here.
http://PUBLIC_IP {
    handle /.well-known/acme-challenge/* {
        root * /var/www/letsencrypt
        file_server
    }
    handle {
        redir https://PUBLIC_IP{uri} permanent
    }
}

PUBLIC_IP {
    tls /etc/caddy/ip-cert/fullchain.pem /etc/caddy/ip-cert/privkey.pem

    @health {
        method GET
        path /health
    }
    handle @health {
        reverse_proxy 127.0.0.1:8765
    }
    @collector {
        method POST
        path /v1/ingest /v1/snapshot
    }
    handle @collector {
        reverse_proxy 127.0.0.1:8765
    }
    handle {
        basic_auth {
            operator REPLACE_WITH_CADDY_PASSWORD_HASH
        }
        reverse_proxy 127.0.0.1:8765 {
            header_up -Authorization
            header_up -Proxy-Authorization
        }
    }
}
