# Copy to /etc/mt5-dashboard/central.env; mode 0600, owner dashboard.
# Host ID must equal the ID already stored in that Windows host's collector DB.
# Generate a different long random token for each Windows host.
DASHBOARD_HOST_TOKENS='{"vps-id":"REPLACE_WITH_RANDOM_TOKEN"}'

# Local Unix socket with PostgreSQL peer authentication: Linux user dashboard
# connects as PostgreSQL role dashboard to database dashboard.
DASHBOARD_POSTGRES_DSN=postgresql:///dashboard

# Required while alert worker is enabled. Reuse the existing bot and chat values.
DASHBOARD_TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
DASHBOARD_TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID
